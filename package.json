{
  "name": "@zesty0wl/starling-mcp",
  "version": "0.1.0",
  "description": "Privacy-first Model Context Protocol server for the Starling Bank public API. Local stdio only, no telemetry, token in the macOS Keychain.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "starling-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "check": "biome check --error-on-warnings . && tsc --noEmit -p tsconfig.json",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "spec:check": "node scripts/check-spec-coverage.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "starling",
    "starling-bank",
    "banking",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Neil Johnson",
  "license": "MIT",
  "homepage": "https://github.com/Zesty0wl/starling-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zesty0wl/starling-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Zesty0wl/starling-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
